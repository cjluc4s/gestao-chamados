      "Holidays": [ "2026-11-02", "2026-11-15", "2026-11-20", "2026-12-25", "2027-01-01" ]
    }
  },
  "SeedData": {
    "AdminEmail": "",
    "AdminPassword": "",
    "AdminFullName": ""
  }
}
