@model gestao_chamados.Models.ViewModels.TicketCreateViewModel
@using gestao_chamados.Models
@{
    ViewData["Title"] = "Novo chamado";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Novo chamado</h1>
        <p class="page-subtitle">Descreva o problema com o máximo de detalhes para agilizar o atendimento.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm d-none d-sm-inline-flex">Cancelar</a>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-8">
        <div class="card surface-card">
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" maxlength="120" data-counter placeholder="Ex.: Impressora do 2º andar sem toner" autofocus />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="6" maxlength="3000" placeholder="O que aconteceu? Desde quando? Já tentou alguma solução?"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Priority" class="form-label"></label>
                            <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<TicketPriority>()" data-sla-select></select>
                            <span asp-validation-for="Priority" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CategoryId" class="form-label"></label>
                            <select asp-for="CategoryId" class="form-select" asp-items="Model.Categories"></select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Files" class="form-label">Anexos</label>
                        <div class="dropzone" data-dropzone="#create-files" data-max-mb="10">
                            <svg class="icon" aria-hidden="true"><use href="#i-upload" /></svg>
                            <strong>Arraste arquivos aqui ou clique para escolher</strong>
                            <small>Máx. 10 MB por arquivo · imagens, PDF, documentos, texto e compactados</small>
                            <input asp-for="Files" type="file" multiple aria-label="Anexos" accept=".jpg,.jpeg,.png,.gif,.pdf,.doc,.docx,.xls,.xlsx,.txt,.zip,.rar" />
                        </div>
                        <ul class="file-list" id="create-files" aria-live="polite"></ul>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary">
                            <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg> Abrir chamado
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <aside class="col-12 col-lg-4">
        <div class="card surface-card">
            <div class="card-header"><svg class="icon" aria-hidden="true"><use href="#i-clock" /></svg> Prazo de atendimento (SLA)</div>
            <div class="card-body">
                <p class="text-muted small">O prazo depende da prioridade escolhida. Use as prioridades mais altas só quando o problema impede o trabalho.</p>
                <ul class="list-unstyled mb-0 d-grid gap-2" id="sla-hints">
                    @foreach (var p in Enum.GetValues<TicketPriority>().OrderByDescending(x => x))
                    {
                        <li class="d-flex justify-content-between align-items-center" data-priority="@((int)p)">
                            <span class="badge-priority @p.CssClass()">@p.Label()</span>
                            <strong>@SlaPolicyHours(p)</strong>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </aside>
</div>

@functions {
    static string SlaPolicyHours(TicketPriority p) => $"{gestao_chamados.Data.SlaPolicy.GetDeadline(p).TotalHours:0} h";
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Destaca na lateral o prazo da prioridade selecionada.
        (function () {
            var select = document.querySelector("[data-sla-select]");
            var items = document.querySelectorAll("#sla-hints li");
            if (!select) return;
            function update() {
                items.forEach(function (li) {
                    var on = li.getAttribute("data-priority") === select.value;
                    li.style.opacity = on ? "1" : "0.55";
                    li.style.transform = on ? "scale(1.02)" : "none";
                    li.style.transition = "all .2s ease";
                });
            }
            select.addEventListener("change", update);
            update();
        })();
    </script>
}
