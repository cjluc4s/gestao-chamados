@model gestao_chamados.Models.ViewModels.TicketDetailsViewModel
@using gestao_chamados.Models
@using gestao_chamados.Data
@{
    ViewData["Title"] = $"Chamado #{Model.Id}";
    var isFinal = TicketWorkflowPolicy.IsFinal(Model.Status);

    string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        return (parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : parts[0][..Math.Min(2, parts[0].Length)]).ToUpperInvariant();
    }
}

@functions {
    string FormatFileSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        _ => $"{bytes / (1024.0 * 1024.0):F1} MB"
    };
}

<div data-live-ticket="@Model.Id">

<div class="notice notice-warning mb-3" id="live-gone" role="alert" hidden>
    <svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg>
    <span>Este chamado mudou e você não tem mais acesso a ele. <a asp-action="Index">Voltar para a lista</a></span>
</div>

<div class="page-header">
    <div>
        <div data-live-region="title">
            <h1 class="page-title">#@Model.Id · @Model.Title</h1>
            <div class="title-badges">
                <span class="badge-status @Model.Status.CssClass()">@Model.Status.Label()</span>
                <span class="badge-priority @Model.Priority.CssClass()">@Model.Priority.Label()</span>
            </div>
        </div>
        <div class="live-row">
            <span class="live-pill" data-live-status data-state="connecting"><span class="dot"></span><span class="label">Conectando…</span></span>
            <div class="presence" id="presence" aria-live="polite" hidden></div>
        </div>
    </div>
    <div class="page-actions" data-live-region="toolbar">
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
        @if (Model.CanEdit)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Editar</a>
        }
        @if (Model.CanCancel)
        {
            <form method="post" asp-action="Cancel" asp-route-id="@Model.Id"
                  data-confirm="O chamado #@Model.Id sai da fila de atendimento, mas o histórico é mantido."
                  data-confirm-title="Cancelar este chamado?" data-confirm-ok="Cancelar chamado">
                <button type="submit" class="btn btn-outline-danger">Cancelar chamado</button>
            </form>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-8">
        <div class="card surface-card mb-3">
            <div class="card-body" data-live-region="summary">
                <p class="ticket-description">@Model.Description</p>
                <hr />
                <dl class="meta-grid mb-0">
                    <div class="meta-item"><dt>Categoria</dt><dd>@Model.Category</dd></div>
                    <div class="meta-item"><dt>Criado por</dt><dd>@Model.CreatedBy</dd></div>
                    <div class="meta-item"><dt>Atribuído para</dt><dd>@(Model.AssignedTo ?? "Não atribuído")</dd></div>
                    <div class="meta-item"><dt>Aberto em</dt><dd>@Model.CreatedAtUtc.ToLocalTime().ToString("g")</dd></div>
                </dl>
            </div>
        </div>

        <div class="card surface-card mb-3">
            <div class="card-header"><svg class="icon" aria-hidden="true"><use href="#i-paperclip" /></svg> Anexos</div>
            <div class="card-body">
                <div data-live-region="attachments">
                @if (!Model.Attachments.Any())
                {
                    <p class="text-muted">Sem anexos.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var att in Model.Attachments)
                        {
                            <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-1 attachment-item">
                                <div>
                                    <svg class="icon attachment-icon" aria-hidden="true"><use href="#i-file" /></svg>
                                    <a asp-action="Download" asp-route-id="@att.Id" class="attachment-link">@att.FileName</a>
                                    <small class="text-muted ms-1">(@FormatFileSize(att.SizeInBytes))</small>
                                </div>
                                <small class="text-muted">@att.UploadedBy · @att.UploadedAtUtc.ToLocalTime().ToString("g")</small>
                            </li>
                        }
                    </ul>
                }
                </div>

                <form method="post" asp-action="UploadToTicket" enctype="multipart/form-data">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="dropzone" data-dropzone="#details-files" data-max-mb="10">
                        <svg class="icon" aria-hidden="true"><use href="#i-upload" /></svg>
                        <strong>Arraste arquivos aqui ou clique para escolher</strong>
                        <small>Máx. 10 MB por arquivo</small>
                        <input type="file" name="files" multiple aria-label="Anexar arquivos" accept=".jpg,.jpeg,.png,.gif,.pdf,.doc,.docx,.xls,.xlsx,.txt,.zip,.rar" />
                    </div>
                    <ul class="file-list" id="details-files" aria-live="polite"></ul>
                    <button type="submit" class="btn btn-outline-primary mt-3">
                        <svg class="icon" aria-hidden="true"><use href="#i-upload" /></svg> Enviar anexos
                    </button>
                </form>
            </div>
        </div>

        <div class="card surface-card mb-3">
            <div class="card-header">Interações</div>
            <div class="card-body">
                <div data-live-region="comments">
                @if (!Model.Comments.Any())
                {
                    <p class="text-muted">Sem interações ainda.</p>
                }
                else
                {
                    foreach (var comment in Model.Comments)
                    {
                        <div class="comment-bubble mb-2 @(comment.IsStaff ? "agent" : "")">
                            <div class="comment-head">
                                <span class="avatar avatar-sm" aria-hidden="true">@Initials(comment.Author)</span>
                                <span class="comment-author">@comment.Author</span>
                                @if (comment.IsStaff)
                                {
                                    <span class="badge-role agent comment-tag">Equipe</span>
                                }
                                <span class="comment-time">@comment.CreatedAtUtc.ToLocalTime().ToString("g")</span>
                            </div>
                            <div class="comment-text">@comment.Message</div>
                        </div>
                    }
                }
                </div>

                <div class="typing-indicator" id="typing" aria-live="polite" hidden>
                    <span class="typing-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <span><span class="typing-name"></span> está digitando…</span>
                </div>

                <form method="post" asp-action="AddComment" class="mt-3">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label for="comment-message" class="visually-hidden">Sua resposta</label>
                    <textarea id="comment-message" name="message" class="form-control" rows="3" maxlength="2000" required placeholder="Digite uma resposta..."></textarea>
                    <button type="submit" class="btn btn-primary mt-2">
                        <svg class="icon" aria-hidden="true"><use href="#i-arrow" /></svg> Responder
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card surface-card mb-3" data-live-region="sla">
            <div class="card-header">
                <svg class="icon" aria-hidden="true"><use href="#i-clock" /></svg> SLA
                @if (Model.IsSlaEscalated)
                {
                    <span class="badge-sla breach ms-auto">Escalonado</span>
                }
            </div>
            <div class="card-body">
                @{
                    var sla = Model.Sla;
                    var badgeClass = sla.State switch
                    {
                        SlaState.Breached => "breach",
                        SlaState.AtRisk => "risk",
                        SlaState.Paused => "paused",
                        SlaState.Done => sla.Breached ? "breach" : "ok",
                        _ => "ok"
                    };
                    var badgeText = sla.State switch
                    {
                        SlaState.Breached => "SLA vencido",
                        SlaState.AtRisk => "Em risco",
                        SlaState.Paused => "Relógio pausado",
                        SlaState.Done => sla.Breached ? "Encerrado fora do prazo" : "Encerrado no prazo",
                        _ => "Dentro do SLA"
                    };
                    var barColor = badgeClass switch
                    {
                        "breach" => "var(--c-danger)",
                        "risk" => "var(--c-warning)",
                        "paused" => "var(--st-waiting-fg)",
                        _ => "var(--c-success)"
                    };
                    var percent = Math.Min(100, (int)Math.Round(sla.Consumed * 100));
                    var unit = Model.SlaUsesBusinessHours ? "úteis" : "corridas";
                }
                <div class="d-flex justify-content-between align-items-baseline mb-1">
                    <span class="badge-sla @badgeClass">@badgeText</span>
                    <span class="text-muted small">@((int)Math.Round(sla.Consumed * 100))% do prazo</span>
                </div>
                <div class="sla-meter sla-meter-lg mb-3" role="progressbar" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100" aria-label="Prazo consumido">
                    <span class="bar-fill" style="--bar: @barColor; width: 0" data-bar="@percent"></span>
                </div>
                <dl class="meta-grid mb-0">
                    <div class="meta-item"><dt>Limite</dt><dd>@(Model.DueAtUtc?.ToLocalTime().ToString("g") ?? "-")</dd></div>
                    <div class="meta-item">
                        @switch (sla.State)
                        {
                            case SlaState.Breached:
                                <dt>Atraso</dt><dd class="text-danger">@sla.Overdue.ToShort() @unit</dd>
                                break;
                            case SlaState.Paused:
                                <dt>Situação</dt><dd>Aguardando o solicitante</dd>
                                break;
                            case SlaState.Done:
                                <dt>Situação</dt><dd>@(sla.Breached ? "Prazo estourado" : "Prazo cumprido")</dd>
                                break;
                            default:
                                <dt>Restam</dt><dd>@sla.Remaining.ToShort() @unit</dd>
                                break;
                        }
                    </div>
                </dl>
                <p class="text-muted small mt-3 mb-0">
                    @(Model.SlaUsesBusinessHours ? "Conta só o horário comercial." : "Conta 24 horas por dia.")
                    @if (sla.State != SlaState.Done)
                    {
                        <text> O relógio pausa enquanto o chamado aguarda o solicitante.</text>
                    }
                </p>
            </div>
        </div>

        <div data-live-region="feedback">
        @if (Model.FeedbackRating is { } given)
        {
            <div class="card surface-card mb-3">
                <div class="card-header"><svg class="icon" aria-hidden="true"><use href="#i-star" /></svg> Avaliação do atendimento</div>
                <div class="card-body">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <partial name="_Stars" model="@((double)given)" />
                        <strong>@FeedbackPolicy.Label(given)</strong>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.FeedbackComment))
                    {
                        <p class="comment-text mt-2 mb-1">@Model.FeedbackComment</p>
                    }
                    <small class="text-muted">Avaliado em @Model.FeedbackAtUtc?.ToLocalTime().ToString("g")</small>
                </div>
            </div>
        }
        else if (Model.CanRate)
        {
            <div class="card surface-card mb-3 feedback-card">
                <div class="card-header"><svg class="icon" aria-hidden="true"><use href="#i-star" /></svg> Como foi o atendimento?</div>
                <div class="card-body">
                    <form method="post" asp-action="Rate">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <fieldset class="rating-input">
                            <legend class="visually-hidden">Nota do atendimento</legend>
                            <div class="rating-stars">
                                @for (var v = 5; v >= 1; v--)
                                {
                                    <input type="radio" name="rating" id="rate-@v" value="@v" required data-label="@FeedbackPolicy.Label(v)" />
                                    <label for="rate-@v" title="@FeedbackPolicy.Label(v)"><svg class="icon" aria-hidden="true"><use href="#i-star" /></svg><span class="visually-hidden">@v @(v == 1 ? "estrela" : "estrelas")</span></label>
                                }
                            </div>
                            <div class="rating-caption" aria-live="polite" data-rating-caption>Escolha de 1 a 5 estrelas</div>
                        </fieldset>
                        <label for="rate-comment" class="form-label mt-3">Quer deixar um comentário? <span class="text-muted fw-normal">(opcional)</span></label>
                        <textarea id="rate-comment" name="comment" class="form-control" rows="3" maxlength="@FeedbackPolicy.MaxCommentLength" placeholder="O que foi bom? O que podemos melhorar?"></textarea>
                        <button type="submit" class="btn btn-primary w-100 mt-3">Enviar avaliação</button>
                    </form>
                </div>
            </div>
        }
        else if (Model.Status is TicketStatus.Resolved or TicketStatus.Closed)
        {
            <div class="card surface-card mb-3">
                <div class="card-body text-muted small d-flex align-items-center gap-2">
                    <svg class="icon" aria-hidden="true"><use href="#i-star" /></svg> Ainda sem avaliação do solicitante.
                </div>
            </div>
        }
        </div>

        @if (User.IsInRole(RoleNames.Agent) || User.IsInRole(RoleNames.Admin))
        {
            <div class="card surface-card mb-3" data-live-region="actions">
                <div class="card-header"><svg class="icon" aria-hidden="true"><use href="#i-zap" /></svg> Ações</div>
                <div class="card-body">
                    <div class="action-block">
                        @if (Model.AllowedStatuses.Any())
                        {
                            <form method="post" asp-action="ChangeStatus">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <label for="status-select" class="form-label">Alterar status</label>
                                <select id="status-select" name="status" class="form-select mb-2">
                                    @foreach (var next in Model.AllowedStatuses)
                                    {
                                        <option value="@next">@next.Label()</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-outline-primary w-100">Alterar status</button>
                            </form>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Chamado encerrado: o status não pode mais ser alterado.</p>
                        }
                    </div>

                    @if (Model.CanAssign)
                    {
                        <div class="action-block">
                            <form method="post" asp-action="Assign" asp-route-id="@Model.Id">
                                <label for="agentId" class="form-label">Atendente responsável</label>
                                <select id="agentId" name="agentId" class="form-select mb-2">
                                    <option value="" selected="@(Model.AssignedToUserId is null)">Não atribuído (fila)</option>
                                    @foreach (var agent in Model.AssignableAgents)
                                    {
                                        <option value="@agent.Value" selected="@(agent.Value == Model.AssignedToUserId)">@agent.Text</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-outline-secondary w-100">
                                    @(Model.AssignedToUserId is null ? "Atribuir" : "Reatribuir")
                                </button>
                            </form>
                        </div>
                    }

                    @if (User.IsInRole(RoleNames.Agent) && string.IsNullOrWhiteSpace(Model.AssignedTo) && !isFinal)
                    {
                        <div class="action-block">
                            <form method="post" asp-action="AssignToMe">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-primary w-100">Assumir chamado</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="card surface-card" data-live-region="history">
            <div class="card-header">Histórico de status</div>
            <div class="card-body">
                @if (!Model.History.Any())
                {
                    <p class="text-muted">Sem histórico.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.History)
                        {
                            <li class="list-group-item px-0 timeline-item">
                                <div>
                                    <strong>@(item.FromStatus?.Label() ?? "(inicial)")</strong>
                                    <span class="status-arrow">→</span>
                                    <strong>@item.ToStatus.Label()</strong>
                                </div>
                                <small class="comment-time">@item.ChangedBy · @item.ChangedAtUtc.ToLocalTime().ToString("g")</small>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

</div>
