@model gestao_chamados.Models.ViewModels.PagedTicketListViewModel
@using gestao_chamados.Models
@using gestao_chamados.Data
@{
    ViewData["Title"] = "Chamados";
    var hasFilters = Model.Status.HasValue || Model.StartDate.HasValue || Model.EndDate.HasValue;
    var startText = Model.StartDate?.ToString("yyyy-MM-dd");
    var endText = Model.EndDate?.ToString("yyyy-MM-dd");
}

<div data-live-list>
<div class="page-header">
    <div>
        <h1 class="page-title">Chamados</h1>
        <p class="page-subtitle" data-live-region="count">
            <span class="result-count">@Model.TotalCount @(Model.TotalCount == 1 ? "chamado" : "chamados")@(hasFilters ? " com os filtros aplicados" : "")</span>
        </p>
        <span class="live-pill mt-1" data-live-status data-state="connecting"><span class="dot"></span><span class="label">Conectando…</span></span>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-success btn-sm" asp-action="ExportCsv"
           asp-route-status="@Context.Request.Query["status"]"
           asp-route-startDate="@Context.Request.Query["startDate"]"
           asp-route-endDate="@Context.Request.Query["endDate"]">
            <svg class="icon" aria-hidden="true"><use href="#i-download" /></svg> CSV
        </a>
        <a class="btn btn-outline-danger btn-sm" asp-action="ExportPdf"
           asp-route-status="@Context.Request.Query["status"]"
           asp-route-startDate="@Context.Request.Query["startDate"]"
           asp-route-endDate="@Context.Request.Query["endDate"]">
            <svg class="icon" aria-hidden="true"><use href="#i-file" /></svg> PDF
        </a>
        @if (User.IsInRole(RoleNames.User) || User.IsInRole(RoleNames.Admin))
        {
            <a class="btn btn-primary btn-sm" asp-action="Create">
                <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg> Novo chamado
            </a>
        }
    </div>
</div>

<nav class="chip-row" aria-label="Filtrar por status">
    <a class="chip @(Model.Status is null ? "active" : "")" asp-action="Index" asp-route-startDate="@startText" asp-route-endDate="@endText">Todos</a>
    @foreach (var s in Enum.GetValues<TicketStatus>())
    {
        <a class="chip s-@s.CssClass() @(Model.Status == s ? "active" : "")" asp-action="Index" asp-route-status="@s" asp-route-startDate="@startText" asp-route-endDate="@endText">@s.Label()</a>
    }
</nav>

<div class="card surface-card mb-3">
    <div class="filters-panel">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label" for="f-status">Status</label>
                <select id="f-status" name="status" class="form-select">
                    <option value="">Todos os status</option>
                    @foreach (var s in Enum.GetValues<TicketStatus>())
                    {
                        <option value="@s" selected="@(Model.Status == s)">@s.Label()</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="f-start">De</label>
                <input id="f-start" name="startDate" type="date" class="form-control" value="@startText" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label" for="f-end">Até</label>
                <input id="f-end" name="endDate" type="date" class="form-control" value="@endText" />
            </div>
            <div class="col-12 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-grow-1">
                    <svg class="icon" aria-hidden="true"><use href="#i-filter" /></svg> Filtrar
                </button>
                @if (hasFilters)
                {
                    <a class="btn btn-outline-secondary" asp-action="Index" title="Limpar filtros" aria-label="Limpar filtros">
                        <svg class="icon" aria-hidden="true"><use href="#i-x" /></svg>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<button type="button" class="live-banner" id="live-list-pill" hidden>
    <svg class="icon" aria-hidden="true"><use href="#i-zap" /></svg>
    Há atualizações na lista. <strong>Clique para atualizar</strong>
</button>

<div class="card surface-card" data-live-region="table">
    <div class="card-body p-0">
        <table class="table table-modern table-stack align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Título</th>
                    <th>Categoria</th>
                    <th>Status</th>
                    <th>Prioridade</th>
                    <th>SLA</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Items.Any())
            {
                <tr class="empty-row">
                    <td colspan="7">
                        <div class="empty-state">
                            <span class="state-icon"><svg class="icon" aria-hidden="true"><use href="#i-inbox" /></svg></span>
                            <h2>@(hasFilters ? "Nada encontrado com esses filtros" : "Nenhum chamado por aqui")</h2>
                            <p>@(hasFilters ? "Tente ampliar o período ou escolher outro status." : "Quando houver chamados, eles aparecem nesta lista.")</p>
                            @if (hasFilters)
                            {
                                <a class="btn btn-outline-primary btn-sm" asp-action="Index">Limpar filtros</a>
                            }
                            else if (User.IsInRole(RoleNames.User) || User.IsInRole(RoleNames.Admin))
                            {
                                <a class="btn btn-primary btn-sm" asp-action="Create"><svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg> Abrir o primeiro chamado</a>
                            }
                        </div>
                    </td>
                </tr>
            }
            @foreach (var item in Model.Items)
            {
                <tr data-href="@Url.Action("Details", new { id = item.Id })">
                    <td data-label="Nº"><strong>#@item.Id</strong></td>
                    <td data-label="Título" class="cell-title cell-wide">@item.Title</td>
                    <td data-label="Categoria">@item.Category</td>
                    <td data-label="Status"><span class="badge-status @item.Status.CssClass()">@item.Status.Label()</span></td>
                    <td data-label="Prioridade"><span class="badge-priority @item.Priority.CssClass()">@item.Priority.Label()</span></td>
                    <td data-label="SLA">
                        @switch (item.SlaState)
                        {
                            case SlaState.Breached:
                                <span class="badge-sla breach"><svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg> @item.SlaLabel</span>
                                break;
                            case SlaState.AtRisk:
                                <span class="badge-sla risk"><svg class="icon" aria-hidden="true"><use href="#i-clock" /></svg> @item.SlaLabel</span>
                                break;
                            case SlaState.Paused:
                                <span class="badge-sla paused"><svg class="icon" aria-hidden="true"><use href="#i-clock" /></svg> @item.SlaLabel</span>
                                break;
                            case SlaState.Done when item.IsSlaBreached:
                                <span class="badge-sla breach"><svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg> @item.SlaLabel</span>
                                break;
                            default:
                                <span class="badge-sla ok"><svg class="icon" aria-hidden="true"><use href="#i-check" /></svg> @item.SlaLabel</span>
                                break;
                        }
                        @if (item.IsSlaEscalated && item.SlaState is SlaState.Breached or SlaState.Paused)
                        {
                            <span class="badge-sla breach ms-1" title="Escalonado ao Admin">Escalonado</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                            Detalhes <svg class="icon" aria-hidden="true"><use href="#i-arrow" /></svg>
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div data-live-region="pagination">
@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Paginação de chamados">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)"
                   asp-route-status="@Model.Status" asp-route-startDate="@startText" asp-route-endDate="@endText">Anterior</a>
            </li>
            @{
                // Janela de páginas ao redor da atual, sempre com a primeira e a última.
                var firstInWindow = Math.Max(1, Model.Page - 2);
                var lastInWindow = Math.Min(Model.TotalPages, Model.Page + 2);
                var pages = new SortedSet<int> { 1, Model.TotalPages };
                for (var p = firstInWindow; p <= lastInWindow; p++) pages.Add(p);
                var previousPage = 0;
            }
            @foreach (var p in pages)
            {
                if (previousPage > 0 && p - previousPage > 1)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@p" aria-current="@(p == Model.Page ? "page" : null)"
                       asp-route-status="@Model.Status" asp-route-startDate="@startText" asp-route-endDate="@endText">@p</a>
                </li>
                previousPage = p;
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)"
                   asp-route-status="@Model.Status" asp-route-startDate="@startText" asp-route-endDate="@endText">Próxima</a>
            </li>
        </ul>
    </nav>
}
</div>
</div>
