@model gestao_chamados.Models.ViewModels.PagedTicketListViewModel
@using gestao_chamados.Models
@{
    ViewData["Title"] = "Chamados";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title mb-0">Chamados</h2>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-success btn-sm" asp-action="ExportCsv"
           asp-route-status="@Context.Request.Query["status"]"
           asp-route-startDate="@Context.Request.Query["startDate"]"
           asp-route-endDate="@Context.Request.Query["endDate"]">📥 CSV</a>
        <a class="btn btn-outline-danger btn-sm" asp-action="ExportPdf"
           asp-route-status="@Context.Request.Query["status"]"
           asp-route-startDate="@Context.Request.Query["startDate"]"
           asp-route-endDate="@Context.Request.Query["endDate"]">📄 PDF</a>
        @if (User.IsInRole(RoleNames.User) || User.IsInRole(RoleNames.Admin))
        {
            <a class="btn btn-primary btn-sm" asp-action="Create">Novo chamado</a>
        }
    </div>
</div>

<div class="card surface-card mb-3">
    <div class="filters-panel">
        <form method="get" class="row g-2">
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">Todos os status</option>
                    @foreach (var s in Enum.GetValues<TicketStatus>())
                    {
                        <option value="@s" selected="@(Model.Status == s)">@s.Label()</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <input name="startDate" type="date" class="form-control" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <input name="endDate" type="date" class="form-control" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3 d-grid">
                <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
            </div>
        </form>
    </div>
</div>

<div class="card surface-card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped align-middle table-modern mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Título</th>
                        <th>Categoria</th>
                        <th>Status</th>
                        <th>Prioridade</th>
                        <th>SLA</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Nenhum chamado encontrado.</td>
                    </tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><strong>@item.Id</strong></td>
                        <td>@item.Title</td>
                        <td>@item.Category</td>
                        <td><span class="badge-status @item.Status.CssClass()">@item.Status.Label()</span></td>
                        <td><span class="badge-priority @item.Priority.CssClass()">@item.Priority.Label()</span></td>
                        <td>
                            @if (item.IsSlaBreached)
                            {
                                <span class="badge-sla breach">⚠ Vencido</span>
                            }
                            else
                            {
                                <span class="badge-sla ok">✓ OK</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detalhes</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Paginação de chamados">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)"
                   asp-route-status="@Model.Status" asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")">Anterior</a>
            </li>
            @{
                // Janela de páginas ao redor da atual, sempre com a primeira e a última.
                var firstInWindow = Math.Max(1, Model.Page - 2);
                var lastInWindow = Math.Min(Model.TotalPages, Model.Page + 2);
                var pages = new SortedSet<int> { 1, Model.TotalPages };
                for (var p = firstInWindow; p <= lastInWindow; p++) pages.Add(p);
                var previousPage = 0;
            }
            @foreach (var p in pages)
            {
                if (previousPage > 0 && p - previousPage > 1)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@p"
                       asp-route-status="@Model.Status" asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")">@p</a>
                </li>
                previousPage = p;
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)"
                   asp-route-status="@Model.Status" asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")">Próxima</a>
            </li>
        </ul>
    </nav>
}
