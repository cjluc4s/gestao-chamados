@model Dictionary<gestao_chamados.Models.TicketPriority, TimeSpan>
@using gestao_chamados.Models
@{
    ViewData["Title"] = "SLAs por prioridade";
    var maxHours = Model.Count == 0 ? 1 : Model.Values.Max(v => v.TotalHours);
}

<div class="page-header">
    <div>
        <h1 class="page-title">SLAs por prioridade</h1>
        <p class="page-subtitle">Tempo máximo para atender um chamado, contado a partir da abertura.</p>
    </div>
</div>

<div class="card surface-card">
    <div class="card-body p-0">
        <table class="table table-modern table-stack align-middle mb-0">
            <thead>
                <tr>
                    <th>Prioridade</th>
                    <th>Tempo máximo</th>
                    <th>Comparativo</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.OrderByDescending(x => x.Key))
            {
                <tr>
                    <td data-label="Prioridade"><span class="badge-priority @item.Key.CssClass()">@item.Key.Label()</span></td>
                    <td data-label="Tempo máximo"><strong>@item.Value.TotalHours.ToString("0") horas</strong></td>
                    <td data-label="Comparativo" class="w-50">
                        <div class="sla-meter" role="img" aria-label="@item.Value.TotalHours horas de @maxHours">
                            <span class="bar-fill @item.Key.CssClass()" style="width: 0; --bar: var(--pr-@(item.Key.CssClass())-dot)" data-bar="@((item.Value.TotalHours * 100 / maxHours).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"></span>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
