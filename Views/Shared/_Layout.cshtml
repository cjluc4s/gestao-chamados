<!DOCTYPE html>
<html lang="pt-BR" class="no-js">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#2563eb" />
    <title>@ViewData["Title"] - Help Desk Corporativo</title>
    <script>
        // Aplica o tema salvo (ou o do sistema) antes da primeira pintura, sem "piscar".
        (function () {
            var d = document.documentElement;
            d.classList.remove('no-js');
            var t = null;
            try { t = localStorage.getItem('theme'); } catch (e) { }
            if (t !== 'light' && t !== 'dark') {
                t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            d.setAttribute('data-bs-theme', t);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-user-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        string NavClass(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link";
        string? NavCurrent(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "page" : null;
        var isAuthenticated = User.Identity?.IsAuthenticated == true;
        var action = ViewContext.RouteData.Values["action"]?.ToString();
        var isAdminArea = string.Equals(controller, "Admin", StringComparison.OrdinalIgnoreCase);
        var isUsers = isAdminArea && string.Equals(action, "Users", StringComparison.OrdinalIgnoreCase);
        var isSla = isAdminArea && string.Equals(action, "Priorities", StringComparison.OrdinalIgnoreCase);
    }
    <partial name="_Icons" />
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>

    <header>
        <nav class="navbar navbar-expand-xl app-navbar">
            <div class="container-xxl">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true"><svg class="icon"><use href="#i-support" /></svg></span>
                    Help Desk
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain"
                        aria-expanded="false" aria-label="Abrir menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-between" id="navbarMain">
                    <ul class="navbar-nav flex-grow-1 ms-sm-3">
                        @if (isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="@NavClass("Dashboard")" aria-current="@NavCurrent("Dashboard")" asp-area="" asp-controller="Dashboard" asp-action="Index">
                                    <svg class="icon" aria-hidden="true"><use href="#i-dashboard" /></svg> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("Tickets")" aria-current="@NavCurrent("Tickets")" asp-area="" asp-controller="Tickets" asp-action="Index">
                                    <svg class="icon" aria-hidden="true"><use href="#i-ticket" /></svg> Chamados
                                </a>
                            </li>
                        }
                        @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Agent))
                        {
                            <li class="nav-item">
                                <a class="@NavClass("Metrics")" aria-current="@NavCurrent("Metrics")" asp-area="" asp-controller="Metrics" asp-action="Index">
                                    <svg class="icon" aria-hidden="true"><use href="#i-chart" /></svg> Métricas
                                </a>
                            </li>
                        }
                        @if (User.IsInRole(RoleNames.Admin))
                        {
                            <li class="nav-item">
                                <a class="@(isUsers ? "nav-link active" : "nav-link")" aria-current="@(isUsers ? "page" : null)" asp-controller="Admin" asp-action="Users">
                                    <svg class="icon" aria-hidden="true"><use href="#i-users" /></svg> Usuários
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("Automation")" aria-current="@NavCurrent("Automation")" asp-controller="Automation" asp-action="Index">
                                    <svg class="icon" aria-hidden="true"><use href="#i-zap" /></svg> Automação
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@(isSla ? "nav-link active" : "nav-link")" aria-current="@(isSla ? "page" : null)" asp-controller="Admin" asp-action="Priorities">
                                    <svg class="icon" aria-hidden="true"><use href="#i-clock" /></svg> SLA
                                </a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container-xxl app-main">
        @if (TempData["Notification"] is string notification)
        {
            <div class="alert-notification mb-3" role="status" data-autodismiss="7000">
                <svg class="icon" aria-hidden="true"><use href="#i-info" /></svg>
                <span>@notification</span>
                <button type="button" class="btn-close" aria-label="Fechar" data-dismiss-alert></button>
            </div>
        }
        <main id="conteudo" role="main" tabindex="-1">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted">
        <div class="container-xxl d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; @DateTime.Now.Year Help Desk Corporativo</span>
            <span>Feito para resolver chamados com clareza.</span>
        </div>
    </footer>

    <div class="toast-stack" id="toast-container" role="region" aria-live="polite" aria-label="Notificações"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/ui.js" asp-append-version="true"></script>
    @if (isAuthenticated)
    {
        @* O hub exige login: em páginas anônimas a conexão só geraria erro 401 no console. *@
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
                integrity="sha512-7SRCYIJtR6F8ocwW7UxW6wGKqbSyqREDbfCORCbGLatU0iugBLwyOXpzhkPyHIFdBO0K2VCu57fvP2Twgx1o2A=="
                crossorigin="anonymous"></script>
        <script src="~/js/notifications.js" asp-append-version="true"></script>
        <script src="~/js/live.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
