@page
@{
    ViewData["Title"] = "Conta bloqueada";
}

<div class="error-panel">
    <h1>🔒</h1>
    <h2>Conta bloqueada temporariamente</h2>
    <p class="text-muted">
        Muitas tentativas de login falharam. Por segurança, sua conta foi bloqueada por alguns minutos.
        Tente novamente mais tarde.
    </p>
    <a class="btn btn-primary mt-3" asp-controller="Home" asp-action="Index">Voltar ao início</a>
</div>
