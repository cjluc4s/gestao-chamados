@page
@{
    ViewData["Title"] = "Verifique seu e-mail";
}

<div class="error-panel">
    <h1>📧</h1>
    <h2>Verifique seu e-mail</h2>
    <p class="text-muted">
        Se existir uma conta com esse e-mail, enviamos um link para redefinição de senha.
    </p>

    @if (TempData["DevResetLink"] is string devLink)
    {
        <div class="alert alert-notification text-start mt-3">
            <strong>Modo desenvolvimento:</strong> este projeto não tem um provedor de e-mail configurado,
            então o link abaixo é exibido diretamente em vez de ser enviado por e-mail.
            <br />
            <a href="@devLink" class="text-break">@devLink</a>
        </div>
    }

    <a class="btn btn-primary mt-3" asp-page="/Account/Login">Voltar para o login</a>
</div>
