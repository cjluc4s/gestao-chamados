@page
@{
    ViewData["Title"] = "Senha redefinida";
}

<div class="error-panel">
    <span class="state-icon"><svg class="icon" aria-hidden="true"><use href="#i-check" /></svg></span>
    <h1 class="h2">Senha redefinida com sucesso</h1>
    <p class="text-muted">Sua senha foi alterada. Você já pode entrar com a nova senha.</p>
    <a class="btn btn-primary mt-3" asp-page="/Account/Login">Ir para o login</a>
</div>
