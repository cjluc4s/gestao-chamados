@page
@model gestao_chamados.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Esqueci minha senha";
}

<h2 class="page-title">Esqueci minha senha</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card surface-card">
            <div class="card-body">
                <p class="text-muted">Informe seu e-mail e enviaremos um link para redefinir sua senha.</p>
                <form method="post">
                    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Enviar link de redefinição</button>
                    <a asp-page="/Account/Login" class="btn btn-outline-secondary">Voltar</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
